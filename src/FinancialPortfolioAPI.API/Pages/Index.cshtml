@page
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfolio Lab · API tester</title>
    <link rel="stylesheet" href="/css/tester.css" />
    <script src="/js/tester.js" defer></script>
</head>
<body>
<header><div class="wrap header-row"><div><span class="eyebrow">FINANCIAL PORTFOLIO API</span><h1>Portfolio Lab</h1><p>Create, fund and manage a test portfolio.</p></div><nav><a href="/api-docs">API explorer</a><a href="/docs">Documentation</a><a href="/postman.json" download>Postman collection</a></nav></div></header>
<main class="wrap">
    <section class="card connection" aria-labelledby="connection-title">
        <div><h2 id="connection-title">Connect to the API</h2><p>Your key stays in this page's memory and is cleared on reload.</p></div>
        <form id="connect-form"><label for="api-key">API key</label><div class="inline"><input id="api-key" type="password" autocomplete="off" required placeholder="Enter your X-Api-Key" /><button>Connect</button><button type="button" id="disconnect" class="secondary">Disconnect</button></div></form>
    </section>
    <div id="notice" role="status" aria-live="polite">Enter the API key configured on the server to begin.</div>
    <section class="section-heading"><div><h2>Portfolios</h2><p>USD · Fixed demo prices, not live market data</p></div><div class="inline"><button id="refresh" class="secondary" disabled>Refresh</button><button id="new-portfolio" disabled>New portfolio</button></div></section>
    <div id="portfolios" class="portfolio-grid"><div class="empty card">Connect to see your portfolios.</div></div>
    <div class="pagination"><button id="previous" class="secondary" disabled>Previous</button><span id="page-info"></span><button id="next" class="secondary" disabled>Next</button></div>
    <details class="card response-panel"><summary>Last API response</summary><p id="request-info">No requests yet.</p><pre id="response-json"></pre></details>
</main>
<dialog id="create-dialog" aria-labelledby="create-title">
    <div class="dialog-heading"><h2 id="create-title">New portfolio</h2><button type="button" data-close="create-dialog" class="secondary" aria-label="Close">×</button></div>
    <form id="create-form">
        <label for="portfolio-name">Portfolio name</label><input id="portfolio-name" required maxlength="200" />
        <label for="client-name">Client name</label><input id="client-name" required maxlength="200" />
        <label for="client-id">Client ID</label><input id="client-id" required maxlength="50" />
        <label for="risk-profile">Risk profile</label><select id="risk-profile"><option>Conservative</option><option selected>Moderate</option><option>Aggressive</option><option>VeryAggressive</option></select>
        <p>New portfolios start with zero cash. Add a deposit in the transaction form to fund one.</p>
        <p class="form-error" role="alert"></p><button>Create portfolio</button>
    </form>
</dialog>
<dialog id="detail-dialog" class="wide" aria-labelledby="detail-title">
    <div class="dialog-heading"><h2 id="detail-title">Portfolio details</h2><button type="button" data-close="detail-dialog" class="secondary" aria-label="Close">×</button></div>
    <p id="detail-meta"></p><div id="metrics" class="metrics"></div>
    <h3>Holdings</h3><div class="table-scroll"><table><thead><tr><th>Symbol</th><th>Shares</th><th>Price</th><th>Market value</th><th>Gain / loss</th></tr></thead><tbody id="holdings"></tbody></table></div>
    <details><summary>Edit portfolio</summary><form id="edit-form">
        <label for="edit-name">Name</label><input id="edit-name" required maxlength="200" />
        <div class="form-grid"><div><label for="edit-risk">Risk profile</label><select id="edit-risk"><option>Conservative</option><option>Moderate</option><option>Aggressive</option><option>VeryAggressive</option></select></div>
        <div><label for="edit-status">Status</label><select id="edit-status"><option>Active</option><option>Inactive</option><option>PendingReview</option><option>Restricted</option><option>Closed</option></select></div></div>
        <button>Save changes</button></form></details>
    <div class="inline actions"><button id="recalculate" class="secondary">Refresh demo prices</button><button id="delete" class="danger">Delete empty portfolio</button></div>
    <p id="detail-error" class="form-error" role="alert"></p>
    <h3>Create transaction</h3>
    <form id="transaction-form">
        <div class="form-grid"><div><label for="transaction-type">Type</label><select id="transaction-type"><option>Deposit</option><option>Withdrawal</option><option>Dividend</option><option>Buy</option><option>Sell</option></select></div>
        <div><label for="reference">Reference number</label><input id="reference" required maxlength="50" /></div></div>
        <div id="cash-fields"><label for="amount">Amount (USD)</label><input id="amount" type="number" min="0.000001" max="1000000000000" step="0.000001" value="10000" required /></div>
        <div id="trade-fields" class="form-grid" hidden><div><label for="symbol">Symbol</label><select id="symbol"><option>AAPL</option><option>MSFT</option><option>NVDA</option></select></div><div><label for="shares">Shares</label><input id="shares" type="number" min="0.000001" max="1000000000" step="0.000001" value="10" /></div><div><label for="price">Execution price (USD)</label><input id="price" type="number" min="0.000001" max="1000000000" step="0.000001" value="170" /></div><div><label for="commission">Commission (USD)</label><input id="commission" type="number" min="0" max="1000000" step="0.000001" value="0" /></div></div>
        <p>Transactions begin Pending. Execute, then settle to apply cash and holdings. Keep the same reference when retrying a request.</p>
        <button>Create pending transaction</button>
    </form>
    <h3>Transactions</h3><div id="transactions"></div>
    <div class="pagination"><button id="tx-previous" class="secondary">Previous</button><span id="tx-page-info"></span><button id="tx-next" class="secondary">Next</button></div>
</dialog>
</body></html>
